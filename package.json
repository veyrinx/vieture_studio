{
  "name": "vieture-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VieTure Studio — Build Ideas. Engineer the Future.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include src/shared --env-file-if-exists=.env src/server/index.ts",
    "build": "vite build && vite build --ssr src/client/site/entry-server.tsx --outDir dist/server && esbuild src/server/index.ts src/server/cli.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist/server --log-level=warning",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p .",
    "cli": "tsx src/server/cli.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.62.0"
  },
  "engines": {
    "node": ">=22"
  }
}
